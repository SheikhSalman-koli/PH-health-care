

{
  "compilerOptions": {
    "module": "ESNext",                                
    "rootDir": "./",
    "outDir": "./dist",   
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src", "prisma7.config.ts"],
  "exclude": ["dist", "node_modules"]
}